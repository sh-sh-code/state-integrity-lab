# State Integrity Lab - environment variables (example)
# Copy this file to `.env` and adjust values.
# Never commit a real `.env` file. Never put secrets you do not own here.

# Path to the SQLite database file.
SIL_DB_PATH=./state_integrity_lab.sqlite3

# Directory where artifacts (screenshots, html snapshots, json files) are stored.
SIL_ARTIFACTS_DIR=./artifacts

# Directory where generated Markdown reports are written.
SIL_REPORTS_DIR=./reports

# Default redaction toggle. When `true`, the report generator will mask
# strings that look like emails, tokens, UUIDs, etc.
SIL_REDACT_BY_DEFAULT=true
